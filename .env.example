# Copy to .env (gitignored). Never commit real values.

# --- Models: Yandex Cloud (PRIMARY - one account covers everything) ---
# Folder ID starts with b1g... (from the console URL, NOT the API key's ID)
YANDEX_CLOUD_FOLDER_ID=
# Service-account API key, starts with AQVN... (shown once at creation)
YANDEX_API_KEY=
# Model string used in n8n: gpt://<folder_id>/qwen3-235b-a22b-fp8/latest
# Base URL for the OpenAI Chat Model node: https://llm.api.cloud.yandex.net/v1

# --- Models: fallback only, leave empty unless Yandex is down ---
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Channels ---
TELEGRAM_BOT_TOKEN=
VK_GROUP_TOKEN=
VK_CONFIRMATION_CODE=

# --- Storage ---
POSTGRES_HOST=
POSTGRES_DB=nxai
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_URL=
QDRANT_URL=http://localhost:6333

# --- CRM / mail ---
BITRIX24_WEBHOOK_URL=
SMTP_HOST=smtp.yandex.ru
SMTP_USER=
SMTP_PASSWORD=

# --- APIs ---
YANDEX_GEOCODER_KEY=
SEARXNG_URL=http://localhost:8080
FIRECRAWL_URL=http://localhost:3002
RUSPROFILE_API_KEY=

# --- Build 4 ---
COPILOT_BEARER_TOKEN=
VITE_WEBHOOK_URL=
